msgstr "Bluetooth cihazı bulunamadı"

#: extension/prefs.js:289
msgid "Make sure BlueZ is running and devices are paired/visible."
msgstr "BlueZ'in çalıştığından ve cihazların eşleştirildiğinden/görünür olduğu"
"ndan emin olun."

#: extension/prefs.js:337
msgid "No Bluetooth devices were returned by BlueZ."
msgstr "BlueZ hiçbir Bluetooth cihazı döndürmedi."

